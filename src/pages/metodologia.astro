---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Methodology from '../components/Methodology.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Metodología de Trabajo | JPVS Gasfiter Cauquenes" 
  description="Descubra nuestro proceso estructurado en 6 pasos para garantizar transparencia, puntualidad y acabados garantizados en Cauquenes."
>
  <Navbar />
  
  <main class="min-h-screen pt-24 pb-16">
    <div class="max-w-[1200px] mx-auto px-grid-gutter pt-8 text-center md:text-left">
      <span class="inline-block px-4 py-1.5 rounded-full bg-secondary/10 text-secondary border border-secondary/20 text-xs font-bold uppercase tracking-wider mb-4">
        Estándar de Calidad
      </span>
      <h1 class="font-display-lg text-4xl md:text-5xl lg:text-6xl text-on-surface mb-4">
        Metodología de Trabajo
      </h1>
      <p class="font-body-lg text-on-surface-variant max-w-2xl text-lg mb-8">
        Cada trabajo sigue un estándar riguroso para que usted tenga certeza absoluta de los costos, materiales y tiempos acordados.
      </p>
    </div>

    <Methodology />

    <section aria-label="Llamado a la acción" class="py-16 px-grid-gutter max-w-[1200px] mx-auto text-center">
      <div class="bg-surface-container rounded-3xl border border-white/10 p-8 md:p-12 shadow-xl">
        <h2 class="font-headline-md text-3xl font-bold text-on-surface mb-4">Comencemos con el diagnóstico</h2>
        <p class="font-body-md text-on-surface-variant max-w-xl mx-auto mb-8">
          Agende una visita técnica para revisar su instalación y recibir un presupuesto claro y sin sorpresas.
        </p>
        <a href="/contacto" class="inline-flex items-center justify-center bg-secondary text-on-secondary px-8 py-3.5 rounded-xl font-bold hover:bg-secondary-fixed transition-colors shadow-lg">
          Agendar Evaluación
        </a>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
