---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Página no encontrada (404) | JPVS Gasfiter Cauquenes" 
  description="La ruta solicitada no se encuentra disponible. Ingrese a la portada de JPVS Gasfiter para conocer nuestros servicios garantizados."
>
  <Navbar />
  
  <main class="min-h-[75vh] flex items-center justify-center pt-28 pb-20 px-grid-gutter relative">
    <div class="max-w-xl mx-auto text-center bg-surface-container rounded-3xl border border-white/10 p-8 md:p-14 shadow-2xl relative z-10">
      
      <div class="w-20 h-20 rounded-2xl bg-secondary/10 border border-secondary/30 flex items-center justify-center text-secondary mx-auto mb-6">
        <span class="material-symbols-outlined text-[44px]">plumbing</span>
      </div>

      <span class="font-headline-lg text-6xl md:text-7xl font-extrabold text-secondary block mb-2">404</span>
      <h1 class="font-display-lg text-3xl md:text-4xl text-on-surface mb-4">
        Página No Encontrada
      </h1>
      
      <p class="font-body-md text-on-surface-variant mb-8 leading-relaxed">
        La ruta que intenta visitar no existe, fue renombrada o ya no está disponible. No se preocupe, todas nuestras soluciones y servicios siguen activos.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="inline-flex items-center justify-center gap-2 bg-secondary text-on-secondary px-6 py-3 rounded-xl font-bold hover:bg-secondary-fixed transition-colors shadow-lg">
          <span class="material-symbols-outlined text-xl">home</span> Volver al Inicio
        </a>
        <a href="/servicios" class="inline-flex items-center justify-center gap-2 bg-surface border border-white/20 text-on-surface px-6 py-3 rounded-xl font-bold hover:border-secondary hover:text-secondary transition-colors">
          <span class="material-symbols-outlined text-xl">build</span> Ver Servicios
        </a>
      </div>

    </div>
  </main>
  
  <Footer />
</Layout>
