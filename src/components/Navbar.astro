---
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItems = [
  { label: "Sobre Mí", href: "/sobre-mi" },
  { label: "Servicios", href: "/servicios", activePrefix: "/servicios" },
  { label: "Metodología", href: "/metodologia" },
  { label: "Proyectos", href: "/proyectos" },
  { label: "FAQ", href: "/faq" },
];

function isItemActive(item: typeof navItems[0]) {
  if (item.activePrefix) {
    return pathname.startsWith(item.activePrefix);
  }
  return pathname === item.href;
}
---
<nav class="sticky bg-surface/90 dark:bg-surface/90 backdrop-blur-md docked full-width top-0 z-50 border-b border-white/10 flat no shadows" id="navbar">
  <div class="flex justify-between items-center px-grid-gutter py-4 max-w-[1200px] mx-auto">
    <a class="font-headline-lg text-headline-lg font-extrabold text-on-surface tracking-tighter hover:text-secondary transition-colors" href="/">JPVS</a>
    
    <!-- Desktop Navigation -->
    <ul class="hidden md:flex gap-8 items-center font-body-md text-body-md nav-links">
      {navItems.map((item) => {
        const active = isItemActive(item);
        return (
          <li>
            <a 
              class={`nav-link transition-all duration-300 pb-1 border-b-2 ${
                active 
                  ? "text-secondary font-bold border-secondary" 
                  : "text-on-surface-variant hover:text-secondary border-transparent"
              }`} 
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
    
    <a 
      class={`hidden md:inline-flex bg-secondary text-on-secondary px-6 py-2 rounded-full font-headline-md text-body-lg font-bold hover:bg-secondary-fixed transition-all hover:scale-105 duration-300 shadow-md ${
        pathname === "/contacto" ? "ring-2 ring-white/50" : ""
      }`} 
      href="/contacto"
    >
      Cotizar Ahora
    </a>
    
    <!-- Mobile Menu Button -->
    <button class="md:hidden text-on-surface p-2 focus:outline-none hover:text-secondary transition-colors" id="mobile-menu-btn" aria-label="Abrir menú">
      <span class="material-symbols-outlined text-[32px]">menu</span>
    </button>
  </div>
  
</nav>

<!-- Mobile Drawer -->
<div class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden transition-opacity duration-300 opacity-0" id="mobile-overlay"></div>
<div class="fixed top-0 -right-full h-full w-4/5 max-w-sm bg-[#0B0F19] border-l border-white/10 shadow-2xl z-50 transition-all duration-300 flex flex-col" id="mobile-drawer">
  <div class="flex justify-between items-center p-6 border-b border-white/10">
    <a href="/" class="font-headline-lg text-2xl font-bold text-on-surface tracking-tighter">JPVS</a>
    <button class="text-on-surface-variant hover:text-white p-2 transition-colors" id="close-menu-btn" aria-label="Cerrar menú">
      <span class="material-symbols-outlined text-[32px]">close</span>
    </button>
  </div>
  
  <ul class="flex flex-col gap-6 p-6 font-body-lg text-xl mobile-nav-links">
    {navItems.map((item) => {
      const active = isItemActive(item);
      return (
        <li>
          <a 
            class={`mobile-link block py-2 border-b border-white/5 transition-colors ${
              active ? "text-secondary font-bold" : "text-on-surface hover:text-secondary"
            }`} 
            href={item.href}
          >
            {item.label}
          </a>
        </li>
      );
    })}
  </ul>
  
  <div class="p-6 mt-auto mb-8">
    <a class="mobile-link flex justify-center items-center bg-secondary text-on-secondary px-6 py-4 rounded-full font-headline-md text-xl font-bold hover:bg-secondary-fixed transition-colors text-center shadow-lg" href="/contacto">Cotizar Ahora</a>
  </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);
  
  // Animate Navbar on load
  gsap.from("#navbar", {
    y: -100,
    opacity: 0,
    duration: 1,
    ease: "power3.out"
  });

  // Mobile Menu Logic
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('close-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('mobile-overlay');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  
  function openMenu() {
    if(!overlay || !drawer) return;
    overlay.classList.remove('hidden');
    setTimeout(() => {
      overlay.classList.remove('opacity-0');
      drawer.classList.remove('-right-full');
      drawer.classList.add('right-0');
    }, 10);
    document.body.style.overflow = 'hidden';
  }
  
  function closeMenu() {
    if(!overlay || !drawer) return;
    drawer.classList.remove('right-0');
    drawer.classList.add('-right-full');
    overlay.classList.add('opacity-0');
    setTimeout(() => { 
      overlay.classList.add('hidden'); 
    }, 300);
    document.body.style.overflow = '';
  }
  
  if (mobileBtn && closeBtn && overlay) {
    mobileBtn.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);
    overlay.addEventListener('click', closeMenu);
    mobileLinks.forEach(link => link.addEventListener('click', closeMenu));
  }
</script>
