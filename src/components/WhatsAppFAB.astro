---
// WhatsApp Floating Action Button with interactive notification pop-up
---
<!-- Container for WhatsApp Floating Action Button & Interactive Pop-up -->
<aside aria-label="Contacto rápido por WhatsApp" class="fixed bottom-6 right-6 md:bottom-8 md:right-8 z-50 flex flex-col items-end pointer-events-none">

  <!-- Interactive Pop-up Bubble / Notification Card -->
  <div 
    id="wa-popup-card" 
    class="pointer-events-auto mb-4 w-[310px] sm:w-[340px] bg-[#0E1526]/95 backdrop-blur-xl border border-secondary/30 rounded-2xl shadow-[0_12px_40px_rgba(0,0,0,0.6)] p-4 transition-all duration-300 opacity-0 scale-90 translate-y-4 pointer-events-none origin-bottom-right"
    role="dialog"
    aria-labelledby="wa-popup-title"
    aria-describedby="wa-popup-desc"
  >
    <!-- Header -->
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-white/10">
      <div class="flex items-center gap-3">
        <div class="relative w-10 h-10 rounded-full bg-secondary/20 border border-secondary/40 flex items-center justify-center text-secondary font-bold text-base shadow-sm">
          <span>JP</span>
          <!-- Active Green Status Dot -->
          <span class="absolute bottom-0 right-0 w-3 h-3 bg-[#25D366] border-2 border-[#0E1526] rounded-full"></span>
        </div>
        <div>
          <span id="wa-popup-title" class="font-headline-md text-base font-bold text-on-surface leading-tight block">JPVS Gasfiter</span>
          <span class="text-xs text-[#25D366] flex items-center gap-1 font-medium">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#25D366] animate-pulse"></span>
            En línea en Cauquenes
          </span>
        </div>
      </div>
      <!-- Close Button -->
      <button 
        id="wa-close-btn" 
        class="text-on-surface-variant hover:text-white p-1 rounded-lg hover:bg-white/10 transition-colors cursor-pointer"
        aria-label="Cerrar notificación de WhatsApp"
      >
        <span class="material-symbols-outlined text-[20px] block">close</span>
      </button>
    </div>

    <!-- Message Bubble -->
    <div class="bg-surface-container/60 border border-white/5 rounded-xl p-3.5 mb-3.5 shadow-inner">
      <p id="wa-popup-desc" class="font-body-md text-sm text-on-surface leading-relaxed">
        👋 <strong class="text-secondary font-semibold">¿Tienes alguna duda o emergencia en tu hogar?</strong>
      </p>
      <p class="font-body-md text-xs text-on-surface-variant mt-1.5">
        Escríbenos directamente y te asesoramos de inmediato con presupuesto sin sorpresas.
      </p>
    </div>

    <!-- CTA Button with High Contrast (Text Dark #0B0F19 on #25D366 background for >10:1 ratio) -->
    <a 
      href="https://wa.me/56975365503?text=Hola%20JPVS%2C%20tengo%20una%20duda%20y%20me%20gustar%C3%ADa%20hacer%20una%20consulta." 
      target="_blank" 
      rel="noopener noreferrer" 
      class="flex items-center justify-center gap-2 w-full bg-[#25D366] hover:bg-[#20ba59] text-[#0B0F19] font-headline-md font-extrabold text-sm py-2.5 px-4 rounded-xl shadow-[0_4px_16px_rgba(37,211,102,0.4)] hover:shadow-[0_6px_20px_rgba(37,211,102,0.6)] transition-all hover:scale-[1.02]"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.456 5.711 1.457h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413Z"/>
      </svg>
      Chatear por WhatsApp
    </a>
  </div>

  <!-- WhatsApp Floating Action Button (FAB) -->
  <div class="relative pointer-events-auto gs-fab-wrapper">
    <!-- Pulsing ambient glow -->
    <span class="absolute -inset-1.5 rounded-full bg-[#25D366] opacity-60 blur-md animate-pulse"></span>
    
    <button 
      type="button"
      id="wa-fab-btn"
      class="relative flex items-center justify-center w-14 h-14 md:w-16 md:h-16 rounded-full bg-[#25D366] text-[#0B0F19] shadow-[0_6px_28px_rgba(37,211,102,0.6)] hover:shadow-[0_8px_36px_rgba(37,211,102,0.85)] hover:scale-110 active:scale-95 transition-transform duration-200 group cursor-pointer focus:outline-none"
      aria-label="Abrir tarjeta de ayuda de WhatsApp de JPVS Gasfiter"
      aria-expanded="false"
      aria-controls="wa-popup-card"
    >
      <!-- Official WhatsApp SVG icon -->
      <svg class="w-7 h-7 md:w-8 md:h-8 fill-current transition-transform duration-300 group-hover:rotate-6 drop-shadow-sm" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.456 5.711 1.457h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413Z"/>
      </svg>

      <!-- Badge "1" message alert -->
      <span 
        id="wa-unread-badge" 
        class="absolute -top-1 -right-1 bg-red-500 text-white text-[11px] font-bold w-5 h-5 rounded-full flex items-center justify-center border-2 border-[#0B0F19] shadow-md animate-bounce"
        aria-hidden="true"
      >
        1
      </span>
    </button>

    <!-- Hover Tooltip (Desktop) -->
    <span class="hidden md:block absolute right-full mr-3 top-1/2 -translate-y-1/2 bg-surface-container-high text-on-surface px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity border border-white/10 pointer-events-none shadow-lg">
      ¿Tienes alguna duda? ¡Escríbenos!
    </span>
  </div>
</aside>

<script>
  import gsap from "gsap";
  import Toastify from "toastify-js";
  import "toastify-js/src/toastify.css";

  // Elements
  const popupCard = document.getElementById("wa-popup-card");
  const closeBtn = document.getElementById("wa-close-btn");
  const fabBtn = document.getElementById("wa-fab-btn");
  const unreadBadge = document.getElementById("wa-unread-badge");

  let isPopupOpen = false;

  // Initial FAB smooth entrance animation with GSAP
  gsap.from(".gs-fab-wrapper", {
    scale: 0.6,
    opacity: 0,
    duration: 0.6,
    delay: 0.5,
    ease: "back.out(1.7)",
    clearProps: "all"
  });

  function showPopup() {
    if (isPopupOpen || !popupCard) return;
    isPopupOpen = true;

    popupCard.classList.remove("pointer-events-none", "opacity-0", "scale-90", "translate-y-4");
    popupCard.classList.add("pointer-events-auto", "opacity-100", "scale-100", "translate-y-0");

    if (fabBtn) fabBtn.setAttribute("aria-expanded", "true");
    if (unreadBadge) unreadBadge.style.display = "none";
  }

  function hidePopup() {
    if (!popupCard) return;
    isPopupOpen = false;

    popupCard.classList.remove("pointer-events-auto", "opacity-100", "scale-100", "translate-y-0");
    popupCard.classList.add("pointer-events-none", "opacity-0", "scale-90", "translate-y-4");

    if (fabBtn) fabBtn.setAttribute("aria-expanded", "false");
  }

  function togglePopup() {
    if (isPopupOpen) {
      hidePopup();
    } else {
      showPopup();
    }
  }

  // Toggle card when clicking the WhatsApp floating button
  if (fabBtn) {
    fabBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      togglePopup();
    });
  }

  // Close button event with session persistence
  if (closeBtn) {
    closeBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      sessionStorage.setItem("jpvs_wa_dismissed", "true");
      hidePopup();
    });
  }

  // Close card when clicking anywhere outside
  document.addEventListener("click", (e) => {
    if (!isPopupOpen || !popupCard) return;
    const target = e.target;
    if (target instanceof Node && !popupCard.contains(target) && !fabBtn?.contains(target)) {
      hidePopup();
    }
  });

  // Automatically deploy the WhatsApp card after exactly 3.5 seconds if not dismissed
  setTimeout(() => {
    const isDismissed = sessionStorage.getItem("jpvs_wa_dismissed") === "true";
    if (isDismissed) return;

    showPopup();

    // Trigger toast notification on desktop for enhanced persuasion
    if (window.innerWidth >= 640) {
      Toastify({
        text: "💬 ¿Tienes alguna duda sobre gasfitería, soldadura o electricidad? ¡Consulta sin compromiso!",
        duration: 5000,
        newWindow: true,
        close: true,
        gravity: "bottom",
        position: "left",
        stopOnFocus: true,
        style: {
          background: "linear-gradient(135deg, #0e1526, #162238)",
          color: "#e4e2e4",
          border: "1px solid rgba(173, 199, 255, 0.3)",
          borderRadius: "16px",
          boxShadow: "0 10px 30px rgba(0,0,0,0.5)",
          padding: "14px 20px",
          fontSize: "14px",
          fontWeight: "500",
          cursor: "pointer"
        },
        onClick: function () {
          window.open(
            "https://wa.me/56975365503?text=Hola%20JPVS%2C%20tengo%20una%20duda%20y%20me%20gustar%C3%ADa%20hacer%20una%20consulta.",
            "_blank"
          );
        }
      }).showToast();
    }
  }, 3500);
</script>
